# Environment Configuration
ENVIRONMENT=development  # development, staging, production

# LM Studio Configuration (for AI Chatbot)
LM_STUDIO_API_TOKEN=your_lm_studio_token_here
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions
LM_STUDIO_MODEL=google/gemma-4-e4b
LM_STUDIO_TIMEOUT=10.0
LM_STUDIO_MAX_TOKENS=45
LM_STUDIO_TEMPERATURE=0.2
LM_STUDIO_TOP_P=0.8

# API Keys (optional)
ALPHA_VANTAGE_KEY=your_key_here
FMP_API_KEY=your_fmp_key_here

# CORS Configuration
# Comma-separated list of allowed origins for production
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Security
# Set to true in production to enforce HTTPS
FORCE_HTTPS=false

# Database (for future use)
# DATABASE_URL=postgresql://user:password@localhost:5432/stockdb

# Redis (for future caching)
# REDIS_URL=redis://localhost:6379/0

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# Pipeline / sentiment (see app.core.config.Settings)
# PIPELINE_ARTICLE_CAP=500
# SENTIMENT_BACKEND=vader
# SENTIMENT_BACKEND=finbert
# FINBERT_BATCH_SIZE=4
# FINBERT_MAX_LENGTH=128
# FINBERT_DEVICE=cuda
# SENTIMENT_HALF_LIFE_HOURS=24
