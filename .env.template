# =============================================================================
# News Sentiment Stock Predictor - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# LM Studio Configuration (AI Chatbot)
# -----------------------------------------------------------------------------
# Get your API token from LM Studio > Local Server > API Token
LM_STUDIO_API_TOKEN=

# LM Studio server URL (default: local server)
LM_STUDIO_URL=http://127.0.0.1:1234/v1/chat/completions

# Model name loaded in LM Studio
LM_STUDIO_MODEL=google/gemma-4-e4b

# Request timeout in seconds
LM_STUDIO_TIMEOUT=10.0

# Maximum tokens in response (controls response length)
LM_STUDIO_MAX_TOKENS=45

# Model temperature (0.0-1.0, lower = more focused)
LM_STUDIO_TEMPERATURE=0.2

# Top P sampling (0.0-1.0)
LM_STUDIO_TOP_P=0.8

# -----------------------------------------------------------------------------
# External API Keys (Optional)
# -----------------------------------------------------------------------------
# Alpha Vantage API key (backup for stock prices)
ALPHA_VANTAGE_KEY=

# Financial Modeling Prep API key (optional)
FMP_API_KEY=

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
# Environment: development, staging, production
ENVIRONMENT=development

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Security Settings
# -----------------------------------------------------------------------------
# Enforce HTTPS (set to true in production)
FORCE_HTTPS=false

# API rate limit per minute
RATE_LIMIT_PER_MINUTE=60

# -----------------------------------------------------------------------------
# CORS Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (production only)
# Example: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# Database (Future Use)
# -----------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/stockdb

# -----------------------------------------------------------------------------
# Redis (Future Use)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# Pipeline Configuration (Optional)
# -----------------------------------------------------------------------------
# Maximum articles to process per run
# PIPELINE_ARTICLE_CAP=500

# Sentiment analysis backend: vader or finbert
# SENTIMENT_BACKEND=vader

# FinBERT settings (if using finbert backend)
# FINBERT_BATCH_SIZE=4
# FINBERT_MAX_LENGTH=128
# FINBERT_DEVICE=cuda
# SENTIMENT_HALF_LIFE_HOURS=24
